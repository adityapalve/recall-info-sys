{
  "name": "recall",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run lint && npm run fmt:check && npm run typecheck && npm test",
    "demo": "npm run demo -w @recall/engine",
    "build": "npm run build -w @recall/web",
    "dev": "npm run dev -w @recall/web",
    "preview": "npm run preview -w @recall/web -- --port 4173 --strictPort"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
